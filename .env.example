# ============================================================
# Office Password Management — environment configuration
# Copy to `.env.local` and fill in real values.
# Generate the two secrets with: npm run genkey
# ============================================================

# --- Session / JWT --------------------------------------------
# 32+ byte random string. Rotating this invalidates all sessions.
JWT_SECRET=replace-me-with-a-long-random-string
# Session lifetime (seconds). Default 8h.
JWT_EXPIRY_SECONDS=28800

# --- Vault encryption (AES-256-GCM) ---------------------------
# 32-byte key, hex (64 chars) or base64. LOSING THIS KEY MAKES
# ALL STORED CREDENTIALS PERMANENTLY UNRECOVERABLE. Back it up.
MASTER_ENCRYPTION_KEY=replace-me-with-64-hex-chars

# --- Storage --------------------------------------------------
# "filesystem" (JSON files under ./data) or "postgres".
# Leave unset to auto-detect: Postgres when a connection string
# is present, filesystem otherwise. On a serverless host with no
# connection string the app refuses to start rather than losing
# data to a read-only, ephemeral disk.
# STORAGE_DRIVER=postgres

# Required when the Postgres driver is active. Vercel Postgres
# sets POSTGRES_URL automatically; Neon/Supabase/Railway give you
# a DATABASE_URL. Use the POOLED connection string in production
# (Neon's "-pooler" host, Supabase's pgBouncer port).
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Brevo SMTP (free tier) -----------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
FROM_EMAIL=no-reply@yourcompany.com
FROM_NAME=Office Password Manager

# --- App ------------------------------------------------------
# Public origin. Used to build the links inside reset emails, so a
# wrong value emails people dead links.
APP_URL=http://localhost:3000
# "true" prints emails to the server console instead of sending
# them (useful before SMTP credentials are provisioned).
EMAIL_DEV_MODE=true

# --- Seed accounts --------------------------------------------
# Read ONLY by `npm run seed`. Do not set these in a hosting
# provider's dashboard: they would park a plaintext password in
# your environment for no benefit.
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_MOBILE=9876543210
SEED_ADMIN_PASSWORD=Admin@12345
SEED_VIEWER_NAME=Viewer
SEED_VIEWER_EMAIL=viewer@company.com
SEED_VIEWER_MOBILE=9876543211
SEED_VIEWER_PASSWORD=Viewer@12345
